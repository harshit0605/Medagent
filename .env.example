# WhatsApp / Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me
WHATSAPP_TEMPLATE_NAMESPACE=
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# When 1 (default if access token is empty), /send logs to message_log without
# calling Meta — safe for local dev / tests. Set 0 in production.
WHATSAPP_DRY_RUN=1

# Service endpoints
ORCHESTRATOR_URL=http://orchestrator:8001/events/inbound
GATEWAY_URL=http://whatsapp_gateway:8000

# Database (Supabase Postgres)
# DATABASE_URL is the pooled connection used by the running services (PgBouncer transaction mode on port 6543).
# DIRECT_URL is the unpooled connection used by alembic migrations (port 5432).
# URL-encode special characters in the password (e.g. `@` -> `%40`).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional: log every SQL statement (debugging only)
SQL_ECHO=0

# Redis / queueing (currently unused at runtime; reserved for future async work)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# LLM provider (used by services/orchestrator/agent_workflow.py)
# When OPENAI_API_KEY is set and LLM_ENABLED is not "0", the agent workflow
# uses the model below for intent classification, safety augmentation, and
# response composition. On any failure (timeout, malformed JSON, missing key)
# the workflow falls back to the deterministic keyword logic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_ENABLED=1
LLM_TIMEOUT_SECONDS=10

# LangGraph + Postgres checkpointer
# When 1, /route invokes a compiled StateGraph with conditional edges and
# durable checkpoints (creates four checkpoint_* tables in public on first run).
# When 0, /route falls back to the deterministic sync runner.
LANGGRAPH_ENABLED=1

# Scheduler service polling loop
# When 1, the scheduler dispatches due scheduled_events on a recurring tick.
# When 0, dispatch only happens via manual POST /scheduler/tick.
SCHEDULER_ENABLED=1
SCHEDULER_POLL_SECONDS=60

# Internal service auth (shared secrets)
# The orchestrator + gateway FAIL CLOSED: they refuse to boot unless their key
# is set (or ALLOW_UNAUTHENTICATED=1 for local dev / tests). The same value
# must exist wherever the service is validated AND wherever it's called:
#   ORCHESTRATOR_API_KEY → orchestrator (validates) + ops console (calls it)
#   GATEWAY_API_KEY      → gateway (validates) + orchestrator / scheduler / ops
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ORCHESTRATOR_API_KEY=
GATEWAY_API_KEY=
# Set to 1 ONLY in local dev / CI to run the services unauthenticated. Never in
# production — leave unset so a missing key fails the service closed.
ALLOW_UNAUTHENTICATED=

# HMAC-signed operator-actor (X-Ops-Actor)
# When set on BOTH the orchestrator and the ops console (same value), the ops
# console signs the X-Ops-Actor header with HMAC-SHA256 and the orchestrator
# verifies it on privileged endpoints (DSAR export, erasure, pause/unpause,
# ticket lifecycle, exemption grant/revoke). operator_actions.details["signed"]
# records whether each row was signed; with REQUIRED=1 the orchestrator returns
# 401 for unsigned/mis-signed headers. Default off → backward-compatible
# caller-asserted semantics.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_ACTOR_SIGNING_KEY=
OPS_ACTOR_SIGNATURE_REQUIRED=

# Max DSAR (right-of-access) exports a single operator may run per rolling 24h.
# 0 disables the limit. Over the ceiling -> 429 + an idempotent ops alert
# ticket (possible credential compromise / un-sanctioned bulk export).
DSAR_EXPORT_DAILY_LIMIT=20

# Two-person rule for patient erasure. When =1, POST /patients/{id}/erase files
# a pending erasure_request (HTTP 202) instead of scrubbing; a DIFFERENT
# operator must approve via POST /erasure-requests/{id}/approve. Default off
# (single-step erasure).
ERASURE_DUAL_CONTROL=0
